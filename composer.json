{
    "name": "kaching/backoffice",
    "description": "Kaching Back Office Presentation & Administration Module",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Kaching Engineering",
            "email": "dev@kaching.id"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kaching\\BackOffice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kaching\\BackOffice\\Tests\\": "tests/",
            "Kaching\\BackOffice\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kaching\\BackOffice\\BackOfficeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
